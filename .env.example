# Copy to .env and fill in. Never commit the real file.

# Cloud PostgreSQL (Neon or any Postgres instance)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Groq API key for Llama-3 (console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: only needed to expose the local Flask API via a tunnel
NGROK_AUTH_TOKEN=your_ngrok_token_here
